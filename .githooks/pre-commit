#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
git diff --quiet --no-ext-diff -- || { echo 'BLOCKED: unstaged tracked changes' >&2; exit 1; }
[ -z "$(git ls-files --others --exclude-standard)" ] || { echo 'BLOCKED: untracked files; decide their tracking' >&2; exit 1; }
exec python3 ./scripts/check-config precommit
